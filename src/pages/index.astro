---
import App from '../app/components/App.tsx';
import '../app/styles/app.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect x=%272%27 y=%272%27 width=%2728%27 height=%2728%27 rx=%277%27 fill=%27%23ebe8e1%27/%3E%3Ctext x=%2716%27 y=%2722%27 font-family=%27sans-serif%27 font-size=%2716%27 font-weight=%27600%27 text-anchor=%27middle%27 fill=%27%23262a36%27%3EK%3C/text%3E%3C/svg%3E" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Change what your keyboard's keys do, its lights and its macros, right in the browser. For keyboards that support VIA." />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1b2136" />
    <title>KeyboardStudio</title>
  </head>
  <body>
    <App client:only="react">
      <main class="landing" slot="fallback">
        <section class="landing-copy">
          <h1 class="landing-title">KeyboardStudio</h1>
          <p class="landing-lede">Change what your keyboard's keys do, its lights and its macros, right here in the browser.</p>
          <div class="landing-actions">
            <button type="button" class="button primary large" disabled>Connect keyboard</button>
          </div>
        </section>
      </main>
    </App>
  </body>
</html>
