---
import DebugPanel from '../debug/DebugPanel.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect x=%272%27 y=%272%27 width=%2728%27 height=%2728%27 rx=%277%27 fill=%27%23ebe8e1%27/%3E%3Ctext x=%2716%27 y=%2722%27 font-family=%27sans-serif%27 font-size=%2716%27 font-weight=%27600%27 text-anchor=%27middle%27 fill=%27%23262a36%27%3EK%3C/text%3E%3C/svg%3E" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>KeyboardStudio debug</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
        line-height: 1.4;
      }
      body {
        margin: 0 auto;
        max-width: 1200px;
        padding: 16px;
      }
      pre,
      code,
      input,
      select,
      textarea {
        font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
        font-size: 13px;
      }
      pre {
        overflow-x: auto;
        padding: 8px;
        border: 1px solid #8884;
      }
      section {
        margin-block: 20px;
      }
      fieldset {
        margin-block: 8px;
      }
      table {
        border-collapse: collapse;
      }
      td,
      th {
        padding: 2px 8px;
        border-bottom: 1px solid #8883;
        text-align: left;
        vertical-align: top;
      }
      .pending {
        color: #b07d00;
      }
      .failed {
        color: #c62828;
      }
      .saved {
        color: #2e7d32;
      }
    </style>
  </head>
  <body>
    <h1>KeyboardStudio debug page</h1>
    <p><a href="./">Back to the app</a></p>
    <p>
      A plain page that exercises the core. Add <code>?mock=1</code> to use the in-memory Linky87 instead of a real keyboard.
      Other options: <code>&amp;latency=2</code> (mock reply delay in ms), <code>&amp;fail=0.1</code> (mock failure rate for writes).
    </p>
    <DebugPanel client:only="react" />
  </body>
</html>
